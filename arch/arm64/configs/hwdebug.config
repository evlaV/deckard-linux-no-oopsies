# hwdebug: catch memory corruption, use-after-free, DMA misuse and
# suspend/resume lifetime bugs in drivers.
#
#   make ARCH=arm64 gabe_defconfig hwdebug.config
#
# Recommended kernel command line additions:
#   page_poison=1 page_owner=on no_hash_pointers kfence.sample_interval=10 iommu.debug_pagealloc=1
# Optional:
#   panic_on_warn=1 oops=panic          (stop at the first report)
#   kmemleak=on                         (leak scanning, costs memory)

CONFIG_LOCALVERSION="-hwdebug"

#
# Writes to free pages (CPU or device DMA)
#
# Free pages are filled with a poison pattern and checked when they are
# allocated again. A write into a free page is reported as
# "pagealloc: memory corruption" with a hexdump and the page owner,
# which catches DMA after free that no CPU-side tool can see.
# Needs page_poison=1 on the command line. Takes precedence over
# init_on_free.
CONFIG_PAGE_POISONING=y
# Remove free pages from the linear map so stray CPU writes fault in the
# writer instead of corrupting memory silently.
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=y
# Record the stack that allocated and freed each page (page_owner=on).
# Used to find who last owned a corrupted page.
CONFIG_PAGE_EXTENSION=y
CONFIG_PAGE_OWNER=y

#
# Page tables and VM
#
# PAGE_TABLE_CHECK needs EXCLUSIVE_SYSTEM_RAM, i.e. /dev/mem may not
# expose RAM.
CONFIG_STRICT_DEVMEM=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_VM_PGFLAGS=y
CONFIG_DEBUG_VM_PGTABLE=y
# Catch virt_to_phys()/__pa() on vmalloc, stack or module addresses.
# A driver doing that hands the device a bogus physical address.
CONFIG_DEBUG_VIRTUAL=y

#
# Slab
#
CONFIG_SLUB_DEBUG=y
# Red zones, poisoning and owner tracking on all caches (slub_debug=FZPU).
CONFIG_SLUB_DEBUG_ON=y
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=10
CONFIG_KFENCE_NUM_OBJECTS=1023
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000

#
# DMA and IOMMU
#
# Check map/unmap/sync pairing, DMA to stack or vmalloc memory, and
# mappings still alive when the driver unbinds.
CONFIG_DMA_API_DEBUG=y
CONFIG_DEBUG_SG=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
CONFIG_ARM_SMMU_QCOM_DEBUG=y
# Check on every page alloc/free that the page is not still mapped in an
# IOMMU domain, i.e. a driver freed a buffer the device can still reach.
# Needs iommu.debug_pagealloc=1 on the command line.
CONFIG_IOMMU_DEBUG_PAGEALLOC=y

#
# Object lifetime: timers, work items and RCU heads freed while still
# active. Typical for drivers tearing down on suspend or remove.
#
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_OBJECTS_PERCPU_COUNTER=y
CONFIG_DEBUG_OBJECTS_ENABLE_DEFAULT=1

#
# Data structure integrity
#
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_PLIST=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

#
# Locking, atomicity, interrupts
#
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_IRQFLAGS=y
CONFIG_DEBUG_PREEMPT=y
# Fire shared IRQ handlers once at request and free time to catch
# handlers that touch hardware or state that is not set up.
CONFIG_DEBUG_SHIRQ=y

#
# Stack and undefined behaviour
#
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
# CONFIG_UBSAN_TRAP is not set
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
# Fill uninitialized stack variables with 0xAA instead of leaving
# whatever was there, so uninitialized use is visible.
CONFIG_INIT_STACK_ALL_PATTERN=y

#
# Suspend/resume
#
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_DPM_WATCHDOG=y

#
# Hangs
#
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y

#
# Decoding reports
#
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_KALLSYMS_ALL=y
# Print the condition string in WARN_ON_ONCE() reports.
CONFIG_DEBUG_BUGVERBOSE_DETAILED=y
CONFIG_STACKTRACE=y

# Turn on KASAN
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# Outline, not inline: inline checks bloat every memory access, and with inline
# the hwdebug Image (243 MB vs 130 MB) is too big for u-boot's memory map.
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_VMALLOC=y

